

# db-connect (episode 003) — set automatically by Vercel's Neon integration.
# For local development, copy the values from Vercel → Storage → your database → .env.local tab.
# DATABASE_URL=postgres://...            (pooled, used by the app)
# DATABASE_URL_UNPOOLED=postgres://...   (direct, used for migrations)

# auth-login (episode 006) — set these in Vercel → Settings → Environment Variables.
# BETTER_AUTH_SECRET=...                (secret: random, 32+ characters; /login can generate one)
# BETTER_AUTH_URL=https://your-domain   (optional; defaults to NEXT_PUBLIC_SITE_URL)
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...              (secret: Google Cloud → Credentials)

# email-send (episode 005) — set these in Vercel → Settings → Environment Variables.
# RESEND_API_KEY=re_...               (secret: Resend → API Keys, "Sending access" only)
# EMAIL_FROM=桌游计分器 <hello@mail.example.com>
# EMAIL_TEST_TO=you@example.com       (where /email-test sends — your own inbox)
# EMAIL_TEST_CODE=...                 (optional secret: lets /email-test send to other addresses)
# EMAIL_REPLY_TO=you@example.com      (optional: where replies go)
